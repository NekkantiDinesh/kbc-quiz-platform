# Port the server listens on
PORT=4000

# Comma-separated list of origins allowed to connect (your deployed client URL)
CLIENT_ORIGIN=http://localhost:5173

# Passcode the host must enter to open the Control Room
HOST_PASSCODE=changeme123

# Default per-question time limit in seconds (used if a question doesn't set its own)
DEFAULT_TIME_LIMIT_SEC=20
